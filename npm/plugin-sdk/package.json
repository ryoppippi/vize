{
  "name": "@vizejs/plugin-sdk",
  "version": "0.428.1",
  "description": "Deterministic authoring and isolated execution for Vize JavaScript plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei-prod/vize.git",
    "directory": "npm/plugin-sdk"
  },
  "files": [
    "index.js",
    "identity.js",
    "index.d.ts",
    "stages.js",
    "stages.d.ts",
    "fixes.js",
    "fixes.d.ts",
    "README.md",
    "sandbox.js",
    "sandbox-worker.js",
    "sandbox.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./fixes": {
      "types": "./fixes.d.ts",
      "default": "./fixes.js"
    },
    "./sandbox": {
      "types": "./sandbox.d.ts",
      "default": "./sandbox.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vizejs/native": "workspace:*"
  },
  "peerDependencies": {
    "@vizejs/native": ">=0.429.0"
  },
  "peerDependenciesMeta": {
    "@vizejs/native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
